#!/build/bin/busybox/sh

export PATH=/build/bin:/build/bin/busybox:$PATH

JOB=${1:-"help"}
NAME=${2:-""}
SRV_DIR=/.init/services
RUN_DIR=/.init/services/run

RUN="/build/bin/supervisord -c /.init/init.conf"

mkdir -p "$RUN_DIR"

[ "$JOB" = "help" ] && {
    echo "Usage: $0 list|start|stop|disable|enable|restart|show [SERVICE]"
    exit 0
}

srv_list() {
    a_count=0
    d_count=0
    t_count=0
    a_names=""
    d_names=""
    t_names=""
    if [ -d "$RUN_DIR" ]; then
        for f in "$RUN_DIR"/*.conf; do
            [ -f "$f" ] || continue
            n=$(basename "$f" .conf)
            a_names="$a_names $n"
            a_count=$((a_count + 1))
        done
    fi
    if [ -d "$RUN_DIR/.disabled" ]; then
        for f in "$RUN_DIR/.disabled"/*.conf; do
            [ -f "$f" ] || continue
            n=$(basename "$f" .conf)
            d_names="$d_names $n"
            d_count=$((d_count + 1))
        done
    fi
    if [ -d "$SRV_DIR" ]; then
        for f in "$SRV_DIR"/*.conf; do
            [ -f "$f" ] || continue
            n=$(basename "$f" .conf)
            t_names="$t_names $n"
            t_count=$((t_count + 1))
        done
    fi
    printf "active    (%d):%s\n" "$a_count" "$a_names"
    printf "disabled  (%d):%s\n" "$d_count" "$d_names"
    printf "templates (%d):%s\n" "$t_count" "$t_names"
}

srv_ls() { srv_list; }

srv_show() {
    $RUN ctl status "$NAME"
}

srv_enable() {
    if [ ! -f "$RUN_DIR/$NAME.conf" ]; then
        if [ ! -f "$SRV_DIR/$NAME.conf" ]; then
            echo "Service not found: $NAME"
            exit 1
        fi
        cp -a "$SRV_DIR/$NAME.conf" "$RUN_DIR/$NAME.conf"
    fi
}

srv_disable() {
    if [ -f "$RUN_DIR/$NAME.conf" ]; then
        rm -f "$RUN_DIR/$NAME.conf"
    fi
}

srv_start() {
    if [ ! -f "$RUN_DIR/$NAME.conf" ]; then
        srv_enable
        $RUN ctl reload
    fi
    $RUN ctl start "$NAME"
}

srv_stop() {
    $RUN ctl stop "$NAME"
}

srv_restart() {
    srv_stop
    srv_start
}

srv_"$JOB"

#!/build/bin/busybox/sh

JOB=${1:-"help"}
NAME=${2:-""}
SRV_DIR=/.init/services
RUN_DIR=/.init/services/run

RUN="/build/bin/supervisord -c /.init/init.conf"

mkdir -p "$RUN_DIR"

[ "$JOB" = "help" ] && {
    echo "Usage: $0 start|stop|disable|enable|restart|show SERVICE"
    exit 0
}

srv_show() {
    $RUN ctl status "$NAME"
}

srv_enable() {
    if [ ! -f "$RUN_DIR/$NAME.conf" ]; then
        if [ ! -f "$SRV_DIR/$NAME.conf" ]; then
            echo "Service not found: $NAME"
            exit 1
        fi
        cp -a "$SRV_DIR/$NAME.conf" "$RUN_DIR/$NAME.conf"
    fi
}

srv_disable() {
    if [ -f "$RUN_DIR/$NAME.conf" ]; then
        rm -f "$RUN_DIR/$NAME.conf"
    fi
}

srv_start() {
    if [ ! -f "$RUN_DIR/$NAME.conf" ]; then
        srv_enable
        $RUN ctl reload
    fi
    $RUN ctl start "$NAME"
}

srv_stop() {
    $RUN ctl stop "$NAME"
}

srv_restart() {
    srv_stop
    srv_start
}

srv_"$JOB"

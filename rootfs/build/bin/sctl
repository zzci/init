#!/build/bin/busybox/sh

export PATH=/build/bin:/build/bin/busybox:$PATH

JOB=${1:-"help"}
NAME=${2:-""}
SRV_DIR=/.init/services
RUN_DIR=/.init/services/run
DIS_DIR=/.init/services/run/.disabled

RUN="/build/bin/supervisord -c /.init/init.conf"

mkdir -p "$RUN_DIR"

[ "$JOB" = "help" ] && {
    echo "Usage: $0 list|start|stop|disable|enable|restart|show [SERVICE]"
    exit 0
}

# Tell supervisord to re-read configs and reconcile (start added,
# stop removed). No-op if supervisord is not running yet.
ctl_reload() {
    $RUN ctl reload >/dev/null 2>&1 || true
}

# List names ending in .conf in a dir, one per line, suffix stripped.
list_conf_names() {
    [ -d "$1" ] || return
    for f in "$1"/*.conf; do
        [ -f "$f" ] || continue
        basename "$f" .conf
    done
}

srv_list() {
    echo "[active]"
    if status=$($RUN ctl status 2>/dev/null) && [ -n "$status" ]; then
        echo "$status"
    else
        list_conf_names "$RUN_DIR"
    fi
    echo "[disabled]"
    list_conf_names "$DIS_DIR"
    echo "[templates]"
    list_conf_names "$SRV_DIR"
}

srv_ls() { srv_list; }

srv_show() {
    $RUN ctl status "$NAME"
}

srv_enable() {
    if [ -f "$DIS_DIR/$NAME.conf" ]; then
        mv "$DIS_DIR/$NAME.conf" "$RUN_DIR/$NAME.conf"
    elif [ ! -f "$RUN_DIR/$NAME.conf" ]; then
        if [ ! -f "$SRV_DIR/$NAME.conf" ]; then
            echo "Service not found: $NAME"
            exit 1
        fi
        cp -a "$SRV_DIR/$NAME.conf" "$RUN_DIR/$NAME.conf"
    fi
    ctl_reload
}

srv_disable() {
    if [ -f "$RUN_DIR/$NAME.conf" ]; then
        mkdir -p "$DIS_DIR"
        mv "$RUN_DIR/$NAME.conf" "$DIS_DIR/$NAME.conf"
        ctl_reload
    fi
}

srv_start() {
    if [ ! -f "$RUN_DIR/$NAME.conf" ]; then
        srv_enable
    fi
    $RUN ctl start "$NAME"
}

srv_stop() {
    $RUN ctl stop "$NAME"
}

srv_restart() {
    srv_stop
    srv_start
}

srv_"$JOB"
